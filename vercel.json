{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    // 1) Serve all files in /assets (JS/CSS/images) directly:
    { "src": "/assets/(.*)", "dest": "/assets/$1" },

    // 2) Optional: Serve favicon, robots, etc:
    { "src": "/favicon\\.ico", "dest": "/favicon.ico" },
    { "src": "/robots\\.txt",  "dest": "/robots.txt" },

    // 3) Catch everything else and rewrite to index.html:
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
